# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Map / payments
VITE_MAPBOX_TOKEN=
VITE_STRIPE_PUBLISHABLE_KEY=

# Phase 5 — Firebase Cloud Messaging (Web)
# Use the Web app config from Firebase Console → Project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push certificate key pair (Firebase Console → Cloud Messaging)
# Alias also accepted in code: VITE_FCM_VAPID_KEY
VITE_FIREBASE_VAPID_KEY=

# Optional pure Web Push (if not using FCM)
# VITE_VAPID_PUBLIC_KEY=

# Edge Function secrets (set via `supabase secrets set`, NOT in Vite):
#   FCM_SERVER_KEY=...
#   PUSH_WEBHOOK_SECRET=...
#   APP_DEEP_LINK_BASE=https://cleanegypt.co
