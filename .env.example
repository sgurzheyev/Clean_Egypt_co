# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Map / payments
VITE_MAPBOX_TOKEN=
VITE_STRIPE_PUBLISHABLE_KEY=

# Phase 5 — Firebase Cloud Messaging (Web)
# Use the Web app config from Firebase Console → Project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push certificate key pair (Firebase Console → Cloud Messaging)
# Alias also accepted in code: VITE_FCM_VAPID_KEY
VITE_FIREBASE_VAPID_KEY=

# Optional pure Web Push (if not using FCM)
# VITE_VAPID_PUBLIC_KEY=

# Optional public site origin (Stripe redirects, auth emails). Defaults to https://garbagin.com
# VITE_APP_ORIGIN=https://garbagin.com

# Cloudflare R2 — public custom domain for media (stores, avatars, mission photos).
# No trailing slash. Object keys like `stores/{userId}/….jpg` resolve to `{base}/{key}`.
# KYC stays private (signed GET via Edge Function) — do not expose kyc/ on this domain
# unless you intentionally configure a private bucket + CDN rules.
# VITE_R2_PUBLIC_BASE_URL=https://media.garbagin.com

# Edge Function secrets (set via `supabase secrets set`, NOT in Vite):
#   FCM_SERVER_KEY=...
#   PUSH_WEBHOOK_SECRET=...
#   APP_DEEP_LINK_BASE=https://garbagin.com
#   R2_ACCOUNT_ID=...
#   R2_ACCESS_KEY_ID=...
#   R2_SECRET_ACCESS_KEY=...
#   R2_PROOF_BUCKET=...
#   R2_PUBLIC_BASE_URL=https://media.garbagin.com
#   R2_S3_ENDPOINT=   (optional override)
#   R2_MAX_MEDIA_BYTES=26214400
